# Copy this file to .env and fill in your private Discord webhook URL.
# Never commit .env or paste your webhook token into a public issue.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ID/REPLACE_TOKEN

# Spring 2027. Use official UF term codes for other semesters.
TERM=2271
CATEGORY=CWSP

# Monitor one or more exact course codes separated by commas.
COURSE_CODES=EEL4712C

# Optional: specific class numbers (blank = all sections in each course).
CLASS_NUMBERS=

# Recommended 30 minutes. Minimum supported: 60 seconds.
CHECK_INTERVAL_SECONDS=1800
